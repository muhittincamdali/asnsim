root = true

[*]
indent_style = space
indent_size = 2
end_of_line = lf
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true

[*.md]
trim_trailing_whitespace = false

# Recorded payloads and snapshots are kept byte for byte as they were written.
[{test/data/**,**/__snapshots__/**}]
trim_trailing_whitespace = false
insert_final_newline = unset
