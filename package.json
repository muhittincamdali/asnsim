{
  "name": "@mcamdali/asnsim",
  "version": "0.1.0",
  "description": "Simulates App Store Server Notifications V2 on your machine: signed refund, renewal, billing retry and grace period notifications posted to your webhook, from a local test certificate chain.",
  "keywords": [
    "app-store",
    "app-store-server-notifications",
    "storekit",
    "in-app-purchase",
    "subscriptions",
    "webhook",
    "jws",
    "signedpayload",
    "testing",
    "simulator",
    "cli"
  ],
  "homepage": "https://github.com/muhittincamdali/asnsim#readme",
  "bugs": "https://github.com/muhittincamdali/asnsim/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/muhittincamdali/asnsim.git"
  },
  "license": "MIT",
  "author": "Muhittin Camdali",
  "type": "module",
  "bin": {
    "asnsim": "dist/cli/main.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "catalog/*.json",
    "scenarios/*.yaml",
    "!dist/**/*.map"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "lint": "biome lint --error-on-warnings . && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "build": "tsc -p tsconfig.build.json",
    "prepack": "npm run build",
    "demo": "npm run build && node scripts/demo.ts",
    "docs": "npm --prefix docs/site run build",
    "smoke": "node scripts/smoke-pack.ts"
  },
  "dependencies": {
    "commander": "15.0.0",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@apple/app-store-server-library": "3.1.0",
    "@biomejs/biome": "2.6.3",
    "@types/node": "26.6.5",
    "@vitest/coverage-v8": "5.0.5",
    "prettier": "3.9.10",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
}
